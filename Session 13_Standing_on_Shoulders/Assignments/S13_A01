#q09

def change_due(paid, total):
    """Return the change owed to the customer, rounded to 2 decimal places."""
    return round(paid - total, 2)


def loyalty_points(total):
    """Return 1 loyalty point for every full Rs 100 spent, using floor division."""
    return int(total // 100)


print(change_due(500, 292.95))
print(loyalty_points(292.95))
print(loyalty_points(1050))

